# Where the agent finds its model. Any OpenAI-compatible API works.
# After editing, run `docker compose up -d` to hand the new values to the agent.
#
# The agent runs in a container, so `localhost` here would be the container
# itself. A model on your laptop is at host.docker.internal instead.

# Ollama on your laptop (the default).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=gemma4:e2b
LLM_PROVIDER=ollama

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-key
# LLM_MODEL=a-model-you-have-access-to
# LLM_PROVIDER=openai

# No model at all: the scripted stand-in that runs in the stack.
# LLM_BASE_URL=http://fake-llm:8090/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=fake-model
# LLM_PROVIDER=fake
