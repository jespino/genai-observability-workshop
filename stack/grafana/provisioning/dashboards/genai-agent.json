{
  "uid": "genai-agent",
  "title": "GenAI agent",
  "tags": [
    "genai"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Agent invocations",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(gen_ai_invoke_agent_duration_seconds_count[5m]))",
          "legendFormat": "invocations",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Tokens used",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(gen_ai_client_inference_usage_input_tokens_total[5m]))",
          "legendFormat": "input",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(gen_ai_client_inference_usage_output_tokens_total[5m]))",
          "legendFormat": "output",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Failed tool calls",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(gen_ai_execute_tool_duration_seconds_count{error_type!=\"\"}[5m])) or vector(0)",
          "legendFormat": "failed",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Failed model calls",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(gen_ai_client_inference_duration_seconds_count{error_type!=\"\"}[5m])) or vector(0)",
          "legendFormat": "failed",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Model call duration (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "{{gen_ai_request_model}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true,
            "showPoints": "auto",
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Tool duration (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_tool_name) (rate(gen_ai_execute_tool_duration_seconds_bucket[5m])))",
          "legendFormat": "{{gen_ai_tool_name}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true,
            "showPoints": "auto",
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Token rate",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(gen_ai_client_inference_usage_input_tokens_total[5m]))",
          "legendFormat": "input",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(gen_ai_client_inference_usage_output_tokens_total[5m]))",
          "legendFormat": "output",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true,
            "showPoints": "auto",
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Tokens per second."
    },
    {
      "id": 8,
      "title": "Calls per invocation (average)",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(gen_ai_invoke_agent_inference_calls_sum[5m])) / sum(rate(gen_ai_invoke_agent_inference_calls_count[5m]))",
          "legendFormat": "model calls",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(gen_ai_invoke_agent_tool_calls_sum[5m])) / sum(rate(gen_ai_invoke_agent_tool_calls_count[5m]))",
          "legendFormat": "tool calls",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true,
            "showPoints": "auto",
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
